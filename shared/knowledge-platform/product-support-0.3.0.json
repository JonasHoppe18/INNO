  "domains": {
    "product_support": {
      "core_families": [
        "DIAG"
      ],
      "families": [
        "DIAG",
        "ESC"
      ]
    }
  },
  "families": {
    "DIAG": {
      "description": "Which published procedure applies, and what is left to try."
    },
    "ESC": {
      "description": "When troubleshooting stops and who takes the case."
    }
  },
  "slots": {
    "product_support.ESC.on_exhausted": {
      "family": "ESC",
      "description": "Where a case goes when the published steps are exhausted or a precondition cannot be met.",
      "value_shape": {
        "exit_domain": "exit_domain"
      }
    }
  },
  "unit_kinds": {
    "procedure": {
      "description": "One published troubleshooting procedure for one problem on one or more models. Applicability and preconditions are typed; the step text is merchant prose and may carry nothing decision-bearing that is not also typed here.",
      "payload_shape": {
        "problem_key": "problem",
        "applies_to_models": [
          "model"
        ],
        "preconditions": [
          {
            "fact": "string",
            "must_be": "truth_value",
            "explain": "string"
          }
        ],
        "steps": [
          {
            "id": "string",
            "order": "integer",
            "text": "string",
            "branch": "string|null",
            "media_ref": "string|null"
          }
        ],
        "on_exhausted": {
          "exit_domain": "exit_domain"
        },
        "provenance": [
          {
            "source_id": "uuid",
            "role": "source_role"
          }
        ]
      }
    },
    "media_asset": {
      "description": "A customer-facing image from the source. It may illustrate a step; it may never be the only place a decision-bearing detail exists.",
      "payload_shape": {
        "asset_ref": "string",
        "usage": "media_usage",
        "describes_step_id": "string|null",
        "text_equivalent": "string"
      }
    },
    "slot_rule": {
      "description": "A typed value for one slot."
    },
    "guidance": {
      "description": "Non-decision-bearing explanation."
    },
    "coverage_state": {
      "description": "Blocked coverage; never an answer."
    }
  },
  "exits": {
    "max_depth": 1,
    "allowed": [
      {
        "from": "product_support",
        "to": "complaints_warranty",
        "when": "steps_exhausted_or_precondition_unmet"
      },
      {
        "from": "product_support",
        "to": "returns",
        "when": "customer_asks_to_return_instead"
      }
    ]
  },
  "composition_rules": [
    "only_steps_not_yet_attempted",
    "never_dump_whole_procedure",
    "applicability_from_typed_models_only",
    "escalate_when_published_procedure_says_so",
    "media_never_sole_source_of_decision"
  ],
  "prose_lint": {
    "forbidden_in_step_text": [
      "warranty",
      "reklamation",
      "refund",
      "return the headset",
      "garanti"
    ]
  },
  "reference_paths": [
    "payload.provenance[].source_id",
    "payload.steps[].media_ref"
  ],
  "global_identifier_paths": []
}
