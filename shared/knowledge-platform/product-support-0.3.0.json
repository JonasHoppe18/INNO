{
  "format": "sona.knowledge-platform/v1",
  "version": "product-support-0.3.0",
  "description": "Product support / troubleshooting v0.2. The frozen v0.1 vocabulary remains unchanged, with source-backed firmware, power-recovery, wireless-interference, and mobile-pairing procedures added as typed model-specific units.",
