      "expansion_unit_ceiling": 100
    }
  },
  "families": {
    "WSTATUS": { "domain": "order_status", "description": "Typed live fulfillment and carrier state without inferred shipment or delivery claims." },
    "WGUIDE": { "domain": "order_status", "description": "Merchant-controlled WISMO guidance; absent guidance remains an explicit Knowledge gap." }
  },
  "slots": {},
  "unit_kinds": { "value": { "requires_slot": false, "decision_bearing": true } },
  "exits": { "graph": [["order_status", "complaints_warranty"]], "max_depth": 2 },
  "composition_rules": [
    "separate_fulfillment_from_carrier_movement",
    "tracking_number_does_not_establish_carrier_possession",
    "never_infer_eta_from_order_age",
    "customer_delivery_claims_are_not_carrier_facts",
    "partial_fulfillment_is_per_line_item",
    "ownership_unverified_withholds_order_details",
    "surface_missing_merchant_guidance_without_improvisation"
  ],
  "reference_paths": { "_all": [{ "path": "provenance[*].source_id", "target": "source" }] },
