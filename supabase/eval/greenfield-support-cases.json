{
  "fixture_workspace_id": "greenfield-demo-workspace",
  "description": "Tenant-neutral support cases for the greenfield contract baseline. The workspace id is harness metadata and is never model-selected.",
  "cases": [
    { "external_id": "gf-wismo-01", "title": "Where is my order", "customer_message": "Where is order #10231?", "order_number": "10231", "expected": { "live_capabilities": ["get_order", "get_tracking"], "required_facts": ["order number", "tracking status", "tracking link"] } },
    { "external_id": "gf-order-status-01", "title": "Order status", "customer_message": "Has order #10232 been sent yet?", "order_number": "10232", "expected": { "live_capabilities": ["get_order"], "required_facts": ["fulfillment status"] } },
    { "external_id": "gf-tracking-01", "title": "Tracking status", "customer_message": "Can you check the tracking for #10231?", "order_number": "10231", "expected": { "live_capabilities": ["get_tracking"], "required_facts": ["carrier", "tracking number", "status"] } },
    { "external_id": "gf-delay-01", "title": "Delayed delivery", "customer_message": "My order #10233 is delayed and the tracking has an exception.", "order_number": "10233", "expected": { "live_capabilities": ["get_order", "get_tracking"], "knowledge_capabilities": ["search_policy"], "knowledge_query": "delayed delivery shipping", "knowledge_types": ["policy"], "required_facts": ["current exception", "next step"] } },
    { "external_id": "gf-return-policy-01", "title": "Return policy", "customer_message": "What is your return window?", "expected": { "knowledge_capabilities": ["search_policy"], "knowledge_types": ["policy"], "required_facts": ["30 days", "condition"] } },
    { "external_id": "gf-return-request-01", "title": "Return request", "customer_message": "I want to return item line-10234 from order #10234.", "order_number": "10234", "expected": { "live_capabilities": ["get_order"], "knowledge_capabilities": ["search_policy"], "proposed_action": "create_return", "required_facts": ["eligibility", "return steps"] } },
    { "external_id": "gf-cancellation-01", "title": "Cancellation request", "customer_message": "Please cancel order #10232 before it ships.", "order_number": "10232", "expected": { "live_capabilities": ["get_order"], "knowledge_capabilities": ["search_procedures"], "proposed_action": "cancel_order", "required_facts": ["current fulfillment state", "confirmation required"] } },
    { "external_id": "gf-address-01", "title": "Address change", "customer_message": "Can you change the delivery address for order #10232?", "order_number": "10232", "expected": { "live_capabilities": ["get_order"], "proposed_action": "update_address", "required_facts": ["order state", "new address needed"] } },
    { "external_id": "gf-damaged-01", "title": "Damaged product", "customer_message": "My Orion Wireless arrived damaged. What do you need from me?", "expected": { "knowledge_capabilities": ["search_procedures", "search_policy"], "knowledge_query": "damaged product warranty", "knowledge_types": ["procedural", "policy"], "required_facts": ["order number", "photos", "packaging"] } },
    { "external_id": "gf-replacement-01", "title": "Replacement request", "customer_message": "The headset is defective. I want a replacement for order #10234.", "order_number": "10234", "expected": { "live_capabilities": ["get_order"], "knowledge_capabilities": ["search_policy", "search_procedures"], "knowledge_query": "replacement defect warranty", "proposed_action": "send_replacement", "required_facts": ["warranty eligibility", "confirmation required"] } },
    { "external_id": "gf-refund-question-01", "title": "Refund timing", "customer_message": "When will my refund arrive after you receive the return?", "expected": { "knowledge_capabilities": ["search_policy"], "knowledge_query": "refund timing", "knowledge_types": ["policy"], "required_facts": ["5 business days", "bank timing may vary"] } },
    { "external_id": "gf-product-01", "title": "Product question", "customer_message": "Does the Orion Wireless support Bluetooth?", "expected": { "knowledge_capabilities": ["search_product_knowledge"], "knowledge_types": ["product"], "required_facts": ["Bluetooth", "included USB receiver"] } },
    { "external_id": "gf-compatibility-01", "title": "Product compatibility", "customer_message": "Are the Orion replacement ear pads compatible with Orion Wired?", "expected": { "knowledge_capabilities": ["search_product_knowledge"], "knowledge_types": ["product"], "required_facts": ["compatible"] } },
    { "external_id": "gf-warranty-01", "title": "Warranty", "customer_message": "How long is the warranty for a manufacturing defect?", "expected": { "knowledge_capabilities": ["search_policy"], "knowledge_types": ["policy"], "required_facts": ["24 months"] } },
    { "external_id": "gf-missing-info-01", "title": "Missing information", "customer_message": "Can you check my order and change it?", "expected": { "response_only": true, "required_facts": ["ask for order number", "ask what change is needed"] } },
    { "external_id": "gf-ambiguous-01", "title": "Ambiguous request", "customer_message": "It is not working. Can you help?", "expected": { "response_only": true, "required_facts": ["ask what product or order", "ask for concise symptom"] } },
    { "external_id": "gf-multi-intent-01", "title": "Multi-intent request", "customer_message": "Where is order #10231, and if it is delayed I want to return it.", "order_number": "10231", "expected": { "live_capabilities": ["get_order", "get_tracking"], "knowledge_capabilities": ["search_policy"], "required_facts": ["current tracking", "return policy", "do not create return without confirmation"] } }
